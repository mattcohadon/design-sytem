{
  "name": "ds-studio",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "description": "Starter pédagogique local pour explorer et faire évoluer un Design System.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx app/server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx app/server/index.ts",
    "launcher": "node scripts/launcher.mjs",
    "test:launcher": "node --test tests/launcher.test.mjs",
    "qualify:desktop": "node scripts/qualify-desktop.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/check-codex.ts",
    "scan": "node scripts/scan-public.mjs",
    "doctor": "node scripts/doctor.mjs",
    "qualify": "node scripts/qualify-local.mjs",
    "qualify:live": "node scripts/qualify-local.mjs --with-codex",
    "test:auth": "tsx scripts/check-auth-failure.ts",
    "format": "prettier --write .",
    "figma:setup": "node scripts/figma-setup.mjs",
    "figma:snapshot": "tsx figma-sync/snapshot.ts",
    "figma:diff": "tsx figma-sync/diff.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.3",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "recharts": "3.8.0",
    "shiki": "4.5.0",
    "simple-icons": "16.36.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
