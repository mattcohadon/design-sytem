{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./app/client/sortui/*"]
    }
  },
  "include": [
    "app",
    "connectors",
    "tests",
    "scripts/*.ts",
    "figma-sync",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
